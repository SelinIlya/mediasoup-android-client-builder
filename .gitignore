# Working directories created by the build scripts. None of them belong in the
# repository — they are fetched or generated by 0_launch_building_android_mediasoup_client.sh
# and its steps, and together they weigh tens of GB.

# step 1: depot_tools clone
depot_tools/

# step 2: python2.7 shim on PATH
symlinks/

# step 3-6: WebRTC checkout, its out/ and out_aar/ trees, and build_output/
webrtc_android/

# step 6: only used when 6_build_webrtc.sh is run outside the normal pipeline
build_output/

# step 7: mediasoup-client-android clone (its own repository)
mediasoup-client-android/

# step 9: Android SDK, NDK and CMake downloaded by sdkmanager
android-sdk/
commandlinetools-linux-*.zip

# step 10: final artifacts
output/
