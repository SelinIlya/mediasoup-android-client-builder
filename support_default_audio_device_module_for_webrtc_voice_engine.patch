diff --git a/api/audio/create_audio_device_module.cc b/api/audio/create_audio_device_module.cc
index 26cb6c12d8..ee4db0efa1 100644
--- a/api/audio/create_audio_device_module.cc
+++ b/api/audio/create_audio_device_module.cc
@@ -16,12 +16,25 @@
 #include "api/scoped_refptr.h"
 #include "modules/audio_device/audio_device_impl.h"
 
+#if defined(WEBRTC_ANDROID)
+#include "sdk/android/native_api/audio_device_module/audio_device_android.h"
+#endif
+
 namespace webrtc {
 
 absl_nullable scoped_refptr<AudioDeviceModule> CreateAudioDeviceModule(
     const Environment& env,
     AudioDeviceModule::AudioLayer audio_layer) {
+#if defined(WEBRTC_ANDROID)
+  // AudioDeviceModuleImpl has no Android backend: CreatePlatformSpecificObjects
+  // only handles Windows/Linux/iOS/Mac, so on Android it fails and returns
+  // null. Route the default ADM to the Android implementation instead, so that
+  // callers which do not supply their own ADM (e.g. WebRtcVoiceEngine) get a
+  // working device.
+  return CreateAndroidAudioDeviceModule(env, audio_layer);
+#else
   return AudioDeviceModuleImpl::Create(env, audio_layer);
+#endif
 }
 
 }  // namespace webrtc
